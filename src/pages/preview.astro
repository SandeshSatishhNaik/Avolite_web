---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import StatusTag from '../components/ui/StatusTag.astro';
import StatusLegend from '../components/ui/StatusLegend.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import { SECTIONS } from '../lib/site.ts';
import { STATUS_IDS } from '../lib/status.ts';

const first = SECTIONS[0];
---

<Base title="Component preview" noindex>
  <div class="wrap pv">
    <h1>Component preview</h1>

    <section aria-labelledby="pv-header-h">
      <h2 id="pv-header-h">Section header</h2>
      <SectionHeader n={first.n} title={first.title} lede="A numbered eyebrow, a heading and a short lede." />
    </section>

    <section aria-labelledby="pv-tags-h">
      <h2 id="pv-tags-h">Status tags</h2>
      <div class="row">
        {STATUS_IDS.map((s) => <StatusTag status={s} provenance={s === 'SIMULATED' ? 'CFAR_Performance_Table.csv' : undefined} />)}
      </div>
    </section>

    <section aria-labelledby="pv-legend-h">
      <h2 id="pv-legend-h">Status legend</h2>
      <StatusLegend />
    </section>

    <section aria-labelledby="pv-ph-h">
      <h2 id="pv-ph-h">Placeholders</h2>
      <div class="stack">
        <Placeholder asset="Dashboard screenshot" status="PROTOTYPE" ratio="16/10" />
        <Placeholder asset="Range-Doppler plot" status="PLANNED" ratio="2.23/1" />
      </div>
    </section>
  </div>
</Base>

<style>
  .pv {
    padding-block: var(--sp-8);
    display: grid;
    gap: var(--sp-8);
  }
  .pv h2 {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    margin-bottom: var(--sp-5);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .stack {
    display: grid;
    gap: var(--sp-5);
  }
</style>
