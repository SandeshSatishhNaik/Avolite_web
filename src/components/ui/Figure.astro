---
import { Picture } from 'astro:assets';
import StatusTag from './StatusTag.astro';
import TableDisclosure from './TableDisclosure.astro';
import { FIGURES, loadImage } from '../../lib/figures.ts';
import type { FigureId } from '../../lib/figures.ts';
import { REPO } from '../../lib/site.ts';

interface Props {
  id: FigureId;
  table?: string;
}

const { id, table } = Astro.props;
const entry = FIGURES[id];
if (!entry) throw new Error(`Figure: unknown figure ${String(id)}`);
const image = await loadImage(id);
---

<figure class="figure" data-claim>
  <div class="plate">
    <Picture src={image} alt={entry.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1280, 1920]} sizes="(min-width: 1440px) 1280px, 100vw" />
  </div>
  <figcaption>
    <p class="figure__title">{entry.title}</p>
    <p class="figure__src">
      <StatusTag status={entry.status} />
      <a href={REPO.blob(entry.path)}>{entry.path}</a>
    </p>
  </figcaption>
  {table && <TableDisclosure datasetId={table} />}
</figure>

<style>
  .figure {
    margin: 0;
  }
  .plate {
    padding: var(--sp-4);
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
  }
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    display: grid;
    gap: var(--sp-2);
    padding-top: var(--sp-3);
  }
  p {
    margin: 0;
  }
  .figure__title {
    color: var(--text-1);
  }
  .figure__src {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    font-family: var(--ff-mono);
    font-size: var(--fs-label);
    overflow-wrap: anywhere;
  }
  .figure__src a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
