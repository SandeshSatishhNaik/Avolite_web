---
// Single entry point for the logo. Art lives in LogoSprite (emitted once per page).
import L from '../../lib/logo.generated.json';

interface Props {
  variant?: 'lockup' | 'mark' | 'wordmark';
  tone?: 'reversed' | 'color';
  label?: string | null;
}

const { variant = 'lockup', tone = 'reversed', label = 'AVOLITE' } = Astro.props;

const uses = variant === 'lockup' ? ['lg-mark', 'lg-word'] : [variant === 'mark' ? 'lg-mark' : 'lg-word'];
---

<svg
  class={`logo logo--${variant} logo--${tone}`}
  viewBox={L.viewBox[variant]}
  role={label ? 'img' : undefined}
  aria-label={label ?? undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {uses.map((id) => <use href={`#${id}`} />)}
</svg>
