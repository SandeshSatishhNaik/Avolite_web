---
import StatusTag from './StatusTag.astro';
import type { Status } from '../../lib/status.ts';

interface Props {
  asset: string;
  status: Status;
  ratio: '16/9' | '16/10' | '2.23/1';
}

// Allow-list: the prop never reaches inline style unchecked (T-2-07).
const RATIOS: Record<string, string> = { '16/9': '16 / 9', '16/10': '16 / 10', '2.23/1': '2.23 / 1' };
const { asset, status, ratio } = Astro.props;
const css = RATIOS[ratio];
if (!css) throw new Error(`Placeholder: unsupported ratio ${String(ratio)}`);
---

<div class="placeholder" data-placeholder style={`aspect-ratio: ${css}`}>
  <div class="placeholder__box">
    <p class="mono">{asset} · pending from the team</p>
    <StatusTag status={status} />
  </div>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    overflow: hidden;
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-panel);
    background-color: var(--bg-0);
    background-image: repeating-linear-gradient(45deg, color-mix(in srgb, var(--line) 70%, transparent) 0 1px, transparent 1px 10px);
  }
  .placeholder__box {
    display: grid;
    justify-items: center;
    gap: var(--sp-2);
    max-width: calc(100% - var(--sp-4));
    padding: var(--sp-3);
    background: var(--bg-1);
    border-radius: var(--r-panel);
    text-align: center;
  }
  p {
    margin: 0;
    color: var(--text-2);
  }
</style>
