---
interface Props {
  n: string;
  title: string;
  lede?: string;
  id?: string;
}

const { n, title, lede, id } = Astro.props;
---

<header class="section-header">
  <p class="eyebrow mono">{n} · {title.toUpperCase()}</p>
  <h2 id={id ? `${id}-h` : undefined}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--sp-3);
    margin-bottom: var(--sp-7);
  }
  .eyebrow {
    margin: 0;
    color: var(--khaki);
  }
  .lede {
    margin: 0;
    max-width: 60ch;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }
</style>
